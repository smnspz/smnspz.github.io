---
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <!-- Body: centered container, mobile padding, system font, readable line-height -->
  <body class="max-w-2xl mx-auto px-6 font-sans leading-relaxed bg-white text-gray-900 dark:bg-gray-950 dark:text-gray-100">
    <!-- Site header -->
    <header class="flex items-center justify-between py-4">
      <!-- Site name -->
      <span class="text-sm font-semibold">srosani</span>
      <nav aria-label="Main navigation" class="flex gap-6 text-sm">
        <!-- Home link -->
        <a href="/" class="text-gray-600 dark:text-gray-400 hover:underline">Home</a>
        <!-- About link -->
        <a href="/about" class="text-gray-600 dark:text-gray-400 hover:underline">About</a>
      </nav>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <!-- Footer -->
    <footer class="py-8 text-center text-sm text-gray-500 dark:text-gray-400">
      <p>&copy; 2026 Simone Rosani</p>
    </footer>
  </body>
</html>
