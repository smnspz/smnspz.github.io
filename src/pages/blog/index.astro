---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import PostList from "../../components/PostList.astro";

// Fetch all blog posts and sort by date, oldest first
const posts = (await getCollection("blog")).sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
---

<Base title="Blog" description="All blog posts.">
  <h1 class="mb-0.5 text-lg">Posts</h1>
  <PostList posts={posts} />
</Base>
