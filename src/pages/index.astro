---
import { getCollection } from "astro:content";
import { Routes } from "../routes";
import Base from "../layouts/Base.astro";

// Fetch all blog posts and sort by date, oldest first
const posts = (await getCollection("blog")).sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
---

<Base title="Blog" description="A personal blog about technology, music, and how the world works.">
  <!-- Bio -->
  <section class="mb-10 space-y-3 text-base leading-relaxed">
    <p>I started studying economics, hoping it would explain how the world actually works. It didn't, and I didn't finish. After a few jobs and a growing urge to build things rather than talk about them, I found my way into software engineering. That one stuck.</p>
    <p>I've been playing drums since middle school, picked up bass and guitar along the way, and spent years bouncing between bands and solo recording projects. I write, record, and produce my own stuff.</p>
    <p>This is where I put thoughts about both worlds, and whatever falls in between.</p>
  </section>
  <!-- Page heading -->
  <h1 class="mb-0.5">Posts</h1>
  <!-- Posts list -->
  <section aria-label="Blog posts" class="space-y-1 text-base">
    {
      posts.map((post) => (
        <a href={`${Routes.Blog}/${post.id}`} class="no-underline text-inherit">
          <article class="flex gap-3 items-center p-2 -mx-2 rounded hover:bg-white/30 dark:hover:bg-white/4 transition-all duration-200 ease-in-out border-b border-gray-100 dark:border-gray-800 last:border-0">
            {post.data.thumbnail && <img src={post.data.thumbnail} alt={`Thumbnail for ${post.data.title}`} class="w-16 h-16 object-cover rounded shrink-0" />}
            <div>
              <h2 class="hover:underline">{post.data.title}</h2>
              <p class="text-sm italic">{post.data.description}</p>
              <time class="text-xs text-[#7a7673] dark:text-[#9a9088]" datetime={post.data.date.toISOString()}>
                {post.data.date.toLocaleDateString("en-US", {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                })}
              </time>
            </div>
          </article>
        </a>
      ))
    }
  </section>
</Base>
